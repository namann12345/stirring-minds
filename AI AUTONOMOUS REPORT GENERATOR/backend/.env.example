# ============================================================================
# AUTONOMOUS REPORT GENERATOR - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in with your actual values
# ============================================================================

# ============== APPLICATION ===============
APP_NAME="Autonomous Report Generator API"
APP_VERSION="1.0.0"
DEBUG=False
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# ============== SECURITY ===============
SECRET_KEY=<generate-with-openssl-rand-hex-32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============== DATABASE ===============
MONGODB_URI=<your-mongodb-atlas-connection-string>
MONGODB_DB_NAME=report_generator

# ============== CORS ===============
CORS_ORIGINS=https://ai-autonomous-report-generator-hypr.vercel.app
CORS_ALLOW_CREDENTIALS=true

# ============== AI SERVICES ===============
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-3.5-turbo

GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# ============== LOGGING ===============
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
